__pycache__/
*.pyc
.pytest_cache/

# Virtualenv
.venv/
.venv-agent/

# Per-user Chrome profiles + generated auto-login extensions (contain cookies/passwords)
user_sessions/

# The one-slot backup every atomic write leaves behind (users.json, selectors.yaml,
# a scenario). It is a safety net for the machine it was written on, not content.
*.bak

# User config holds logins/passwords - copy users.example.json, or scaffold your
# own with --init-users-json
users.json

# Server log sources name real hosts and can carry an access token - copy
# logsources.example.json
logsources.json

# The stacks on the Services & Logs page: absolute paths into somebody's own
# checkouts, and the container names beside them - copy services.example.json
services.json

# Run artifacts: screenshots and full-page DOM dumps of whatever the flows visited,
# so they carry the app's data. Regenerated on every --run-tests run.
reports/
!reports/.gitkeep

# One directory per cycle run: its record, its logs, whatever its steps wrote.
# Same reasoning as reports/ - it is the output of running the thing, not the
# thing. In a source checkout the data root IS the checkout, so without this
# every run would show up as something to commit. No trailing slash: a
# checkout whose runs were moved keeps a link here, and a link is not a folder.
cycle-runs

# The values of cycles' secret variables, and the key that decrypts them. A
# cycle file declares only that a variable is secret; the value lives here, and
# here is never the project. Listed even though the default puts both under the
# user's data root, because in a source checkout the data root IS the checkout.
cyclesecrets.json
cyclesecrets.key
# And what cycles remember - the plan, what a listener has seen - for the same
# reason: in a source checkout the data root is the checkout.
cyclememory.json

# Local IDE run configurations: they name real environments and users
# (--env=..., --user=...), so they stay on the machine that uses them.
.vscode/
.idea/

# Build artifacts (setuptools drops these in the source tree; an *.egg-info left
# behind also makes importlib.metadata report a version from an uninstalled tree)
build/
dist/
*.egg-info/

# Local archives/snapshots
*.tar.gz
*.zip

# The GUI's own virtualenv (created by gui/bootstrap.py)
gui/.venv/

# Built installers: the .deb is ~96 MB. The versioned directory and its
# SHA256SUMS are committed (they record what was released); the payload is not.
installers/**/*.deb
installers/**/*.exe
