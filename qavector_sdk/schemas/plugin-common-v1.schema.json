{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qavector:schema:plugin-common:1",
  "title": "PluginCommon v1",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "contribution_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "nullable_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "limits": {
      "type": "object",
      "properties": {
        "wall_time_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "turns": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "tokens": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "cost_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "json_schema": {
      "type": [
        "object",
        "boolean"
      ]
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "waiting_input",
        "cancelling",
        "completed",
        "failed",
        "cancelled",
        "timed_out",
        "unknown"
      ]
    }
  }
}
