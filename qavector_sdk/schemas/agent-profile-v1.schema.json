{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qavector:schema:agent-profile:1",
  "title": "AgentProfile v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "backend_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
    },
    "backend_version": {
      "type": "string",
      "pattern": "^(?:==|>=|<=|>|<)(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:,(?:==|>=|<=|>|<)(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*))*$"
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "instructions": {
      "type": "string"
    },
    "credentials_ref": {
      "$ref": "urn:qavector:schema:plugin-common:1#/$defs/nullable_ref"
    },
    "limits": {
      "$ref": "urn:qavector:schema:plugin-common:1#/$defs/limits"
    },
    "backend_options": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "id",
    "revision",
    "backend_ref",
    "backend_version",
    "model",
    "instructions",
    "credentials_ref",
    "limits",
    "backend_options"
  ],
  "additionalProperties": false
}
