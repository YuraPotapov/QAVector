{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qavector:schema:node-request:1",
  "title": "NodeRequest v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_ref": {
      "$ref": "urn:qavector:schema:plugin-common:1#/$defs/nullable_ref"
    },
    "artifact_refs": {
      "$ref": "urn:qavector:schema:plugin-common:1#/$defs/refs"
    },
    "output_schema": {
      "anyOf": [
        {
          "$ref": "urn:qavector:schema:plugin-common:1#/$defs/json_schema"
        },
        {
          "type": "null"
        }
      ]
    },
    "limits": {
      "$ref": "urn:qavector:schema:plugin-common:1#/$defs/limits"
    },
    "config": {
      "type": "object"
    },
    "inputs": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "node_id",
    "attempt_id",
    "workspace_ref",
    "artifact_refs",
    "output_schema",
    "limits",
    "config",
    "inputs"
  ],
  "additionalProperties": false
}
