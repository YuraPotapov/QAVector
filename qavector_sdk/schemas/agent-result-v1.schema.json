{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qavector:schema:agent-result:1",
  "title": "AgentResult v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "backend_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
    },
    "plugin_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "cancelled",
        "timed_out",
        "unknown"
      ]
    },
    "summary": {
      "type": "string"
    },
    "output": {},
    "artifact_refs": {
      "$ref": "urn:qavector:schema:plugin-common:1#/$defs/refs"
    },
    "session_ref": {
      "$ref": "urn:qavector:schema:plugin-common:1#/$defs/nullable_ref"
    },
    "usage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "metrics": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "name",
                  "value",
                  "unit"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "source",
            "metrics"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "urn:qavector:schema:agent-error:1"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "attempt_id",
    "backend_ref",
    "plugin_version",
    "status",
    "summary",
    "output",
    "artifact_refs",
    "session_ref",
    "usage",
    "error"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "$ref": "urn:qavector:schema:agent-error:1"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "EXECUTION_STATE_UNKNOWN"
              },
              "retryable": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
