#!/bin/sh
# User data is deliberately never removed.
#
# ~/QAVector holds signed-in Chrome profiles, credentials and run reports, and it
# belongs to the user rather than to this package - dpkg did not create it (the
# app did, on first run) and dpkg does not delete it. Say where it is instead, so
# anyone who does want it gone can remove it themselves.
set -e

case "$1" in
  remove|purge)
    update-desktop-database -q /usr/share/applications 2>/dev/null || true
    gtk-update-icon-cache -q -f /usr/share/icons/hicolor 2>/dev/null || true
    ;;
esac

if [ "$1" = purge ]; then
  echo "QAVector: your sessions, credentials and reports were left in"
  echo "  ~/QAVector   (and ~/.local/share/qavector)"
  echo "Remove those directories by hand if you want them gone."
fi

exit 0
