{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binary",
    "tools"
  ],
  "properties": {
    "binary": {
      "type": "string",
      "minLength": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "disallowed_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "permission_mode": {
      "enum": [
        "",
        "default",
        "acceptEdits",
        "plan",
        "dontAsk"
      ]
    },
    "effort": {
      "enum": [
        "",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "additional_directory": {
      "type": "string"
    }
  }
}
